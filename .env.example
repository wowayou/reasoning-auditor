# Optional server-side provider configuration.
# Keep this file free of real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local development: true. Public deployments: false.
AUDITOR_ALLOW_TRANSIENT_PROVIDER_CONFIG=true

# The web entrypoint also respects PORT. Use 0.0.0.0 in containers.
AUDITOR_HOST=127.0.0.1
AUDITOR_PORT=8000
